    "@types/node": "^24.10.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "prisma": "^7.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.15.6"
